# Copy to .env after OpenAI registers and approves this hosted app.
PORT=4173
TODO_HOST=127.0.0.1
TODO_PUBLIC_URL=http://localhost:4173
# Register the exact callback: http://localhost:4173/auth/chatgpt/callback
OPENAI_CLIENT_ID=
# Enable only after hosted ChatGPT plan usage is approved for this client.
TODO_CHATGPT_PLAN_ENABLED=false
# The token-endpoint authentication method provisioned for your client.
OPENAI_TOKEN_AUTH_METHOD=none
# Confidential clients use client_secret_basic with this server-side secret.
OPENAI_CLIENT_SECRET=
# Optional personal development only: local-codex. Default: visitor's account.
TODO_USAGE_MODE=chatgpt
